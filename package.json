{
  "name": "@arraypress/file-utils",
  "version": "1.5.0",
  "description": "File utilities \u2014 human-readable sizes, filename sanitisation for storage and Content-Disposition, useful names for files from the web, and MIME type classification. Zero dependencies.",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "types": "./src/index.d.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "file",
    "filesize",
    "filename",
    "sanitize",
    "content-disposition",
    "mime",
    "mime-types",
    "upload",
    "file-naming",
    "download"
  ],
  "author": "David Sherlock",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arraypress/file-utils.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
